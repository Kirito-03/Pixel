{
  "expo": {
    "scheme": "pixelnosekai",
    "name": "Pixel No Sekai",
    "slug": "pixel-no-sekai",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-arle.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-arle.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dragonflux.pixelnosekai",
      "googleServicesFile": "./config/google-services.json"
    },
    "web": {
      "favicon": "./assets/icon-arle.png",
      "name": "Pixel No Sekai",
      "shortName": "Pixel",
      "themeColor": "#0a0a0a",
      "description": "Tu plataforma de streaming de Anime favorita",
      "lang": "es-MX"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-arle.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
